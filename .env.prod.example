# Copie para .env.prod e edite com valores reais (NUNCA commite .env.prod)

# Domínio público da aplicação (sem https:// na frente)
DOMAIN=seu-dominio.com

# Banco de dados
POSTGRES_USER=orcapro
# Gere com `openssl rand -hex 32` (hex evita caracteres especiais na URL do banco).
POSTGRES_PASSWORD=SUBSTITUA_PELA_SAIDA_DE_openssl_rand_hex_32
POSTGRES_DB=orcapro

# Autenticação
# Gere com `openssl rand -hex 64`.
JWT_SECRET=SUBSTITUA_PELA_SAIDA_DE_openssl_rand_hex_64
ADMIN_EMAIL=seu-email-de-admin@seu-dominio.com
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# E-mail de recuperação de senha (SMTP com STARTTLS)
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USERNAME=seu-usuario
SMTP_PASSWORD=sua-senha
SMTP_FROM=nao-responda@seu-dominio.com
